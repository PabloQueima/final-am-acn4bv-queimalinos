<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_general"
    android:background="@drawable/fondo">

    <TextView
        android:id="@+id/txtBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola"
        android:textSize="@dimen/texto_subtitulo"
        android:textColor="@color/color_dark2"
        android:textStyle="bold"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/txtSesionesCompletadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sesiones completadas: 0"
        android:textSize="@dimen/texto_general"
        android:textColor="@color/color_dark2"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtTituloSesionesDisponibles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sesiones Disponibles"
        android:textSize="@dimen/texto_subtitulo"
        android:textStyle="bold"
        android:textColor="@color/color_dark2"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorSesiones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Últimas sesiones completadas"
        android:textSize="@dimen/texto_general"
        android:textColor="@color/color_dark2"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5">

        <LinearLayout
            android:id="@+id/contenedorSesionesCompletadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/color_accent"
        android:padding="12dp"
        android:text="Deslogearse"
        android:textColor="@color/color_light"/>
</LinearLayout>
