<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_general"
    android:background="@color/color_background">

    <ImageView
        android:layout_width="@dimen/logo_splash"
        android:layout_height="@dimen/logo_splash"
        android:layout_marginBottom="@dimen/margen_sesion"
        android:src="@drawable/logo"
        android:contentDescription="@string/desc_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/color_text_on_secondary"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/margen_sesion" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:textColor="@color/color_text_on_primary"
        android:backgroundTint="@color/color_primary"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margen_tarjeta" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_register"
        android:textColor="@color/color_background"
        android:backgroundTint="@color/color_secondary"
        android:visibility="gone" />

</LinearLayout>
