<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_general"
    android:background="@color/color_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtTituloEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold"
            android:textColor="@color/color_dark"
            android:layout_marginBottom="8dp"
            android:text="Ejercicio"/>

        <ImageView
            android:id="@+id/imgEjercicio"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:scaleType="centerCrop"
            android:background="@color/color_light"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtDescripcionEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_dark2"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtElementoEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elemento"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_dark2"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtParteCuerpoEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parte del cuerpo"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_dark2"
            android:layout_marginBottom="4dp"/>

    </LinearLayout>

</ScrollView>
