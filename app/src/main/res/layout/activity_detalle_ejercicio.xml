<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding_general"
    android:background="@color/color_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtTituloEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold"
            android:textColor="@color/color_text_on_secondary"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <ImageView
            android:id="@+id/imgEjercicio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_imagen_detalle"
            android:scaleType="centerCrop"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <TextView
            android:id="@+id/txtDescripcionEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_text_on_secondary"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <TextView
            android:id="@+id/txtElementoEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_text_on_secondary"
            android:layout_marginBottom="@dimen/margen_pequeno"/>

        <TextView
            android:id="@+id/txtParteCuerpoEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/texto_general"
            android:textColor="@color/color_text_on_secondary"/>

    </LinearLayout>
</ScrollView>
