<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/padding_general"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/inputBuscarSesion"
            android:hint="@string/hint_buscar_sesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <Button
            android:id="@+id/btnCrearSesion"
            android:text="@string/btn_crear_sesion"
            android:textColor="@color/color_text_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSesiones"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_recycler_grande"
            android:layout_marginBottom="@dimen/margen_seccion"/>

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            android:textColor="@color/color_text_on_primary"
            android:backgroundTint="@color/color_accent"/>
    </LinearLayout>
</ScrollView>
