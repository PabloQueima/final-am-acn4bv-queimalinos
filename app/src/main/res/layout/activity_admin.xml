<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_general">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_dashboard_admin"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold"
            android:textColor="@color/color_text_on_secondary"
            android:layout_marginBottom="@dimen/margen_sesion" />

        <TextView
            android:id="@+id/tvTotalUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvTotalClientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvTotalEntrenadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvTotalEjercicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvTotalSesiones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvTotalSesionesCompletadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"/>

        <TextView
            android:id="@+id/tvPromedioSesionesPorCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_on_secondary"
            android:layout_marginBottom="@dimen/margen_seccion"/>

        <Button
            android:id="@+id/btnGestionUsuarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_gestion_usuarios"
            android:textColor="@color/color_text_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="@dimen/margen_tarjeta"/>

        <Button
            android:id="@+id/btnGestionEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_gestion_ejercicios"
            android:textColor="@color/color_text_on_primary"
            android:backgroundTint="@color/color_secondary"
            android:layout_marginBottom="@dimen/margen_seccion"/>

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            android:textColor="@color/color_text_on_primary"
            android:backgroundTint="@color/color_accent" />
    </LinearLayout>

</ScrollView>
